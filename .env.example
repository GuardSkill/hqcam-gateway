# =============================================================================
# 海雀摄像头网关 · 环境变量模板
# 用法：cp .env.example .env  然后填入你自己的信息（.env 不要提交到 git！）
# =============================================================================

# ---------------------------------------------------------------- 必填
# 海雀 App 的登录账号（手机号）与密码
HQ_USER=13800000000
HQ_PASS=your_password

# 摄像头设备 ID（32 位十六进制，App 设备详情里 / 抓包 RelayInit 帧里能看到）
HQ_DEVICE=00000000000000000000000000000000

# App 设备标识 app_did（32 位十六进制）
# 注意：它不是 APK 常量，而是 App 首次启动时生成、并与你的账号绑定的标识，
#       因此属于个人信息，镜像里不预置，必须自己填。
#       获取方式：抓一次 App 的登录/连接包（RelayInit 帧的 SetConnInfo.f2.f2），
#                 或从 App 数据目录里读取。
HQ_APPDID=00000000000000000000000000000000

# ---------------------------------------------------------------- 可选
# ★ 访问令牌（强烈建议设置！）
#   设置后，网关所有端点都必须携带令牌，否则返回 401：
#     - 浏览器：打开 http://<IP>:8899/ → 会看到登录页，粘贴令牌即可（Cookie 记住一年）
#     - 播放器/脚本：URL 加 ?token=<TOKEN>
#     - 程序调用：请求头 Authorization: Bearer <TOKEN> 或 X-Token: <TOKEN>
#   留空 = 完全不鉴权（同网段任何人都能看画面/控云台/喊话，且 /status.json 会明文吐出会话 sk）
#   生成方法：python -c "import secrets;print(secrets.token_urlsafe(24))"
HQ_TOKEN=

# 宿主暴露的 HTTP 端口（容器内固定 8899）
HQ_HTTP_PORT=8899

# 已发布的镜像地址（部署时改成你自己的 GHCR 路径）
HQ_IMAGE=ghcr.io/your-github-name/hqcam-gateway:latest

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 离线行为（可选）
# 摄像头断电 / 拔掉 / 断网时，网关会一直尝试重连。下面几个参数控制它别失控：
#
# 拉流连接空闲多少秒就主动断开（给 /live.ts、/av.ts、/audio.wav 用）
#   摄像头离线时，这些端点收不到数据，必须主动断开，否则录像容器每次重连
#   都会在网关里留下一个永久挂死的线程（2026-10-22 事故：29 小时 1655 个）。
HQ_STREAM_IDLE=20

# 重连退避：首次 3 秒，之后 6/12/24/48 封顶 60 秒；连上后稳定跑过 30 秒即重置
HQ_RECONNECT_MIN=3
HQ_RECONNECT_MAX=60
HQ_RECONNECT_STABLE=30

# /mjpeg 预览单连接最长秒数（兜底回收，前端每 15 分钟自动换新流）
HQ_MJPEG_MAX_SECS=7200

# ---------------------------------------------------------------- 录像（可选）
# 启动录像：docker compose --profile recorder up -d
#
# ★ 录像落盘位置（宿主路径，可以指向另一块盘/任意目录）
#   容器内固定挂在 /rec。目录必须存在且属主可写（见下方 HQ_REC_UID/GID）。
#   例：HQ_REC_HOST_DIR=/vol2/1000/hqcam-rec
HQ_REC_HOST_DIR=./data/rec

# 录像文件属主。fnOS 的 /vol1/1000、/vol2/1000 是 uid=1000 gid=1001
HQ_REC_UID=1000
HQ_REC_GID=1001

# 每段秒数（300 = 5 分钟一段，方便按时间段回看）
HQ_REC_SEG=300

# 按日期分子目录
#   1 = 开（默认）：<HQ_REC_HOST_DIR>/2026-10-18/cam_20261018_213000.ts
#   0 = 关：全部平铺在 <HQ_REC_HOST_DIR>/ 下
# 清理时会连空的日期目录一起删掉；切换开关不影响旧文件被识别和清理。
HQ_REC_DATE_DIRS=1

# ★ 滚动保留：三道保险，任意一道触发都会删最旧的片段
#   ① 超过天数  ② 超过总容量  ③ 磁盘可用低于底线
#   1080p/3K 实测约 125 KB/s → 1 天 ≈ 10.5 GB，3 天 ≈ 31 GB
HQ_REC_KEEP_DAYS=3
HQ_REC_KEEP_GB=0            # 0 = 不按容量限制（建议设成磁盘的 80% 作双保险）
HQ_REC_MIN_FREE_GB=10       # 磁盘可用低于此值就强删最旧（0 = 关闭）

# 清理检查间隔秒数（录制过程中也会执行，不会等到断流）
HQ_REC_CLEANUP_EVERY=300

HQ_REC_MKV=                 # 设为 1 则收段后转 .mkv（占 CPU）

# ---------------------------------------------------------------- MQTT 桥（可选）
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_SNAP_INTERVAL=10
